# generated by setup.sh / the run scripts -- never commit
xml*/
movies/
log/
bhdata/
cm.txt
visitlog.py
xml_log.txt
__pycache__/
*.pyc
*.tar.gz

# user data -- ignore everything in h5data except the geometry we ship.
# Enumerating the data filenames instead misses Psi4_rad.mon.N, ejv_GW.N.dat
# and a symlinked horizon/ (a trailing slash does not match a symlink).
h5data/*
!h5data/*.3d
!h5data/*.py
!h5data/link_h5data.sh

# editing backups and run logs
*.orig
*.bak
*.bak[0-9]*
*.log

# generated by setup.sh from your own data -- per-case, never commit
bin/grid_code/bhcen[0-9].txt
bin/bw_many_folder_scripts/overlap.txt
bin/bw_many_folder_scripts/duplicate.txt
bin/bw_many_folder_scripts/gap.txt
bin/bw_many_folder_scripts/list_sorted.txt
bin/bw_many_folder_scripts/list_tmp.txt
bin/gpto3d
# per-case set definitions -- the bot is generic, the sets are not.
# setN adds params<N> + runMulti<N>.sh/runLocal<N>.sh for one case's views, cuts and job sizing.
# Keep them in the case tree, never on this branch; the shipped `params` is the template they copy.
params[0-9]*
runMulti[0-9]*.sh
runLocal[0-9]*.sh
# pid file written by renderMissing.sh so a resumed run can be found without pgrep patterns
.renderMissing*.pid
