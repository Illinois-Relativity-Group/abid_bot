# .gitignore for gravity_wave_generation -- keep only source; ignore local data / outputs /
# build artifacts (all regenerable from the pipeline). Nothing here is deleted from disk.

# ---- generated / large data directories ----
VTKdata/
psi4_dir/

# ---- lookup tables (generated by make_lookup*, hundreds of MB) ----
bin/ylm_lookup_2D.txt
bin/r_lookup_2D*.txt
bin/Psi4_rad.sort

# ---- compiled binaries / build artifacts (rebuild from the .cpp / .f90 source) ----
bin/calc_clm
bin/calc_clm_memory
rhphc_wave_generation/flux
rhphc_wave_generation/rhphc.intel.bak
# NOTE: rhphc_wave_generation/rhphc is intentionally tracked (skip-worktree working binary) -- not ignored.

# ---- intermediate / sorted GW data ----
rhphc_wave_generation/Psi4_rad.mon_sorted.*
rhphc_wave_generation/Psi4_rad.mon.input_file
*.clm

# ---- editor / sed scratch ----
bin/sed??????
*~
.DS_Store

# ---- python cache ----
__pycache__/
*.pyc

# ---- logs ----
*.log
